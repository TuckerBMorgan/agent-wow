# The tested spectator environment, with account authentication in place of API keys.
ARG AGENT_BASE_IMAGE=143551238491.dkr.ecr.us-west-2.amazonaws.com/agent-wow:build-viewer-20261024-v3
FROM ${AGENT_BASE_IMAGE}
RUN mv /usr/local/bin/run-wow-agent /usr/local/bin/run-wow-agent-base \
    && sed -i 's/env -u CODEX_API_KEY/env -u CODEX_AUTH_JSON -u CODEX_API_KEY/g' /usr/local/bin/start-agent-workspace
COPY --chmod=755 docker/run_codex_subscription.py /usr/local/bin/run-wow-agent
COPY --chmod=755 docker/run_batch_job.py /usr/local/bin/run-batch-job
ENV CODEX_AUTH_MODE=subscription CODEX_MODEL_PROVIDER=openai CODEX_MODEL=gpt-6.1-sol CODEX_REASONING_EFFORT=medium
